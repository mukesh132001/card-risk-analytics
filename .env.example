# Copy to .env (git-ignored) or set in your shell.
DATABASE_URL=postgresql+psycopg://card:card@localhost:5432/cardrisk
# Secret salt for masking client/account IDs in the reporting layer (any long random string).
PII_SALT=change-me-to-a-long-random-string
# Colleague assistant (M7). Get a key at console.anthropic.com. Without it the assistant runs in offline mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
